# Copy to .env (untracked) and fill in your own values.
# NEVER commit the real .env - it maps real account numbers to public labels.

# --- Google Cloud (only needed for the BigQuery pipeline) -------------------
# Use your own GCP project; enable the BigQuery API and billing/free tier first.
GCP_PROJECT_ID=your-gcp-project
# Keep the multi-region "US" (the raw dataset is a US multi-region dataset).
GCP_REGION=US
GCP_RAW_DATASET=raw
GCP_ANALYTICS_DATASET=analytics
# dbt creates <analytics>_staging and <analytics>_marts datasets automatically.

# --- Account anonymization: ACCOUNT_<real number> = <label> ----------------
# The number is stripped before any row leaves this machine. Labels are fixed.
ACCOUNT_Z90000000=LLC_MAIN
ACCOUNT_900000001=ROTH_IRA
ACCOUNT_900000002=ROLLOVER_IRA
ACCOUNT_Z90000001=INDIVIDUAL_LEGACY

# Files whose names do not contain an account number
FILE_monthly-export=LLC_MAIN
FILE_ytd-export=LLC_MAIN

# --- Databricks (only needed for dbt_databricks / the Spark notebook) ------
# Create a short-lived personal access token; do not reuse a long-lived one.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# DATABRICKS_TOKEN=<short-lived-personal-access-token>
# DATABRICKS_CATALOG=workspace
# DATABRICKS_SCHEMA=default
